{
  "name": "tiktok-live-comment-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Windows desktop app for sending TikTok LIVE comments with a bundled local backend.",
  "author": "TikTok LIVE Comment Desk",
  "main": "main.cjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "npm run build:backend && electron .",
    "build:backend": "esbuild ../server/index.ts --bundle --platform=node --format=cjs --external:playwright-core --outfile=backend.bundle.cjs",
    "check": "node --check main.cjs && node --check preload.cjs && node --check renderer.js",
    "pack": "npm run build:backend && electron-builder --win --dir",
    "dist": "npm run build:backend && electron-builder --win nsis"
  },
  "build": {
    "appId": "com.tiktoklive.commentdesk",
    "productName": "LIVE Comment Desk",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "index.html",
      "renderer.js",
      "styles.css",
      "backend.bundle.cjs",
      "package.json"
    ],
    "asarUnpack": [
      "backend.bundle.cjs",
      "node_modules/playwright-core/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "LIVE Comment Desk"
    }
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.25.5"
  },
  "dependencies": {
    "playwright-core": "^1.64.1"
  }
}
