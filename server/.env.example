# Backend gửi bình luận cho desktop app.
# Sao chép file này thành server/.env rồi điền giá trị thật. Không commit .env.

# Bắt buộc: token mà app desktop gửi trong header Authorization (>= 16 ký tự).
APP_TOKEN=thay-bang-token-ngau-nhien-dai

# Chế độ thử: 1 = chỉ kiểm tra dữ liệu, không gọi TikTok/Euler (không cần credential).
SEND_DRY_RUN=1

# Cách gửi bình luận khi SEND_DRY_RUN=0.
# webcast (mặc định): gửi thẳng tới API webcast của TikTok bằng cookie phiên — miễn phí, không cần key.
# euler: chuyển qua dịch vụ trung gian Euler Stream — khi đó EULER_API_KEY (gói trả phí) là bắt buộc.
SEND_PROVIDER=webcast
EULER_API_KEY=
# Cookie sessionid và tt-target-idc của tài khoản TikTok dùng để gửi.
TIKTOK_SESSION_ID=
TIKTOK_TT_TARGET_IDC=
# Tùy chọn: username của chính tài khoản gửi, giúp khớp đúng bình luận của mình.
SENDER_UNIQUE_ID=

# Tùy chọn.
HOST=127.0.0.1
PORT=3001
ECHO_CONFIRM=1
ECHO_TIMEOUT_MS=10000
SEND_MIN_INTERVAL_MS=2000
SEND_MAX_PER_MINUTE=20
